# AI Bridge web front: letter reading pages + member admin.
# Assumes: TLS certificate for the bridge domain (e.g. via acme.sh /
# certbot), nginx Basic Auth file at /etc/nginx/bridge.htpasswd holding
# the operator's read account. Paths match bridge.conf defaults
# (BRIDGE_ROOT=/srv/bridge, admin service on 127.0.0.1:8471).
server {
    listen 8443 ssl;
    server_name bridge.example.com;

    ssl_certificate     /etc/nginx/certs/bridge.example.com.crt;
    ssl_certificate_key /etc/nginx/certs/bridge.example.com.key;

    auth_basic           "AI Bridge";
    auth_basic_user_file /etc/nginx/bridge.htpasswd;

    # Reading pages: the renderer writes .html siblings of the letters
    # under the bridge root; serve them read-only.
    location / {
        alias /srv/bridge/;
        try_files $uri $uri.html =404;
        autoindex off;
        limit_except GET { deny all; }
    }

    # Member admin (bridge-admin.py on loopback).
    location /admin/ {
        proxy_pass http://127.0.0.1:8471/;
        proxy_set_header Host $host;
    }
}
